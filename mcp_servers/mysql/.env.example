# MySQL MCP settings. Copy to .env and fill in. Never commit .env.
# scripts/setup_demo_db.py creates a working .env for the local demo database.

# ---- Database ----
# Use a MySQL account that ONLY has SELECT on the database it should expose.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mcp_demo
MYSQL_USER=mcp_readonly
MYSQL_PASSWORD=
# MYSQL_MAX_ROWS=500
# MYSQL_QUERY_TIMEOUT_MS=10000

# ---- MCP server ----
# Clients must send "Authorization: Bearer <MCP_API_KEY>". At least 32 characters.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
# 127.0.0.1 = this machine only. Behind the gateway (later) it listens on the internal network.
MCP_HOST=127.0.0.1
MCP_PORT=8101
# Host headers the server accepts (DNS-rebinding protection). Add the gateway host later,
# e.g. 127.0.0.1:*,localhost:*,mcp.itrendsolution.com
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# The URL clients use, and the platform that will issue tokens (Phase 4).
# MCP_PUBLIC_URL=http://127.0.0.1:8101/mcp
# MCP_PLATFORM_URL=http://127.0.0.1:8000
