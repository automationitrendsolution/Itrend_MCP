# MySQL MCP settings. Copy to .env and fill in. Never commit .env.
# scripts/setup_demo_db.py creates a working .env for the local demo database.

# ---- Database ----
# Use a MySQL account that ONLY has SELECT on the database it should expose.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mcp_demo
MYSQL_USER=mcp_readonly
MYSQL_PASSWORD=
# MYSQL_MAX_ROWS=500
# MYSQL_QUERY_TIMEOUT_MS=10000

# ---- Token checking (iTrend MCP Platform) ----
# Clients send a token generated on the platform website. This server asks the
# platform whether each token may be used here, authenticating with this shared
# secret. It must equal MCP_INTROSPECTION_KEY in the platform's .env (32+ characters).
MCP_INTROSPECTION_KEY=
# This MCP's slug in the platform registry, and where the platform runs.
MCP_SLUG=mysql
MCP_PLATFORM_URL=http://127.0.0.1:8000
# How long a "token is valid" answer is remembered. Revocation takes effect within this time.
# MCP_TOKEN_CACHE_SECONDS=30

# ---- MCP server ----
# 127.0.0.1 = this machine only. Behind the gateway (later) it listens on the internal network.
MCP_HOST=127.0.0.1
MCP_PORT=8101
# Host headers the server accepts (DNS-rebinding protection). Add the gateway host later,
# e.g. 127.0.0.1:*,localhost:*,mcp.itrendsolution.com
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# The URL clients use (tokens are bound to it).
# MCP_PUBLIC_URL=http://127.0.0.1:8101/mcp
