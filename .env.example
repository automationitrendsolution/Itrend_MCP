# Copy this file to .env and fill in the values. Never commit .env.

# ---- Django ----
# Generate a key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True only on developer machines. Production must use False.
DJANGO_DEBUG=True
# Comma-separated host names this site may be served under.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to submit forms, e.g. https://mcp.itrendsolution.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional (production defaults shown):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=False
# Time zone for showing times (stored as UTC either way), e.g. Asia/Kolkata. Default UTC.
# DJANGO_TIME_ZONE=UTC
# DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_TO_FILE=False

# ---- MCP platform ----
# Public base URL of the MCP gateway. Hosted MCPs are reachable at <base>/<slug>/.
# Public address of the MCP gateway (this website + /mcp). Connection links are <this>/<slug>/.
# Default http://127.0.0.1:8000/mcp. Production: https://mcp.itrendsolution.com/mcp
# MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000/mcp
# Shared secret MCP servers use to ask the platform whether a token is valid
# (POST /api/v1/tokens/introspect/). At least 32 characters; the same value goes
# in each MCP server's .env. Empty = token checking off, so MCP servers refuse everyone.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_INTROSPECTION_KEY=
# Your own MCPs (one folder each, with mcp.json) and where their output is written.
# MCP_SERVERS_DIR=mcp_servers
# MCP_LOG_DIR=var/mcp_logs
# How often (seconds) the website looks for new or changed mcp.json files. 0 = only on request.
# MCP_DISCOVERY_INTERVAL=30

# ---- Monitoring (manage.py monitor_mcps) ----
# How often (seconds) the monitor wakes up; each MCP is checked at its own interval
# (set on the Monitoring page, default 30 s).
# MONITOR_TICK_SECONDS=5
# Health checks, traffic counts and incidents older than this many days are deleted.
# MONITORING_RETENTION_DAYS=14
# The monitor touches this file every round so the website knows it is running.
# MONITOR_HEARTBEAT_FILE=var/monitor.heartbeat

# ---- Database ----
# mysql (default) or sqlite (local development only).
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=itrend_mcp
DB_USER=root
DB_PASSWORD=
# DB_CONN_MAX_AGE=60

# ---- Access tokens ----
# Who may create tokens that never expire: all, service_accounts or none.
# TOKEN_LIFETIME_ALLOWED=all

# ---- Login protection ----
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# SESSION_COOKIE_AGE=28800

# ---- API rate limits ----
# API_THROTTLE_ANON=60/min
# API_THROTTLE_USER=600/min
