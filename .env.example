# Copy this file to .env and fill in the values. Never commit .env.

# ---- Django ----
# Generate a key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True only on developer machines. Production must use False.
DJANGO_DEBUG=True
# Comma-separated host names this site may be served under.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to submit forms, e.g. https://mcp.itrendsolution.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional (production defaults shown):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_TIME_ZONE=UTC
# DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_TO_FILE=False

# ---- Database ----
# postgresql (default, required in production) or sqlite (local development only).
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itrend_mcp
DB_USER=itrend_mcp
DB_PASSWORD=
# DB_CONN_MAX_AGE=60

# ---- Login protection ----
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# SESSION_COOKIE_AGE=28800

# ---- API rate limits ----
# API_THROTTLE_ANON=60/min
# API_THROTTLE_USER=600/min
